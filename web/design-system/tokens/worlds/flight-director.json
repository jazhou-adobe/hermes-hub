  "overrides": {
    "font-sans": {
      "$type": "fontFamily",
      "$value": "var(--font-archivo), ui-sans-serif, system-ui, sans-serif",
      "$description": "Archivo (variable 100–900): every operational word: Round titles, Questions, headings, controls, navigation."
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "var(--font-ibm-plex-mono), ui-monospace, monospace",
      "$description": "IBM Plex Mono 400–700: callsigns, Round ids, timers and code, always with tabular numerals."
    },
    "font-condensed": {
      "$type": "fontFamily",
      "$value": "var(--font-michroma), 'Eurostile', Arial, sans-serif",
      "$description": "Michroma (one 400 cut), the wide console face. Identity and short legends only: the display line, the app-bar brand, holder status words and the GO / NO-GO calls. Round titles and headings never use it."
    },
    "type-display-size": {
      "$type": "dimension",
      "$value": "2.125rem",
      "$description": "Michroma is wide: a smaller display keeps hero lines on one row."
    },
    "type-display-line-height": {
      "$type": "number",
      "$value": 1.15,
      "$description": "Open leading for the wide face."
    },
    "type-display-weight": {
      "$type": "fontWeight",
      "$value": "var(--hh-font-weight-regular)",
      "$description": "Michroma ships one weight; never synthesised bold."
    },
    "type-heading-lg-family": {
      "$type": "fontFamily",
      "$value": "var(--hh-font-sans)",
      "$description": "Section and page headings are operational: Archivo, not the wide face."
    },
    "type-heading-lg-size": {
      "$type": "dimension",
      "$value": "1.5rem",
      "$description": "Archivo bold headings sized for scanning."
    },
    "type-heading-lg-line-height": {
      "$type": "number",
      "$value": 1.2,
      "$description": "Heading leading for Archivo."
    },
    "type-heading-lg-weight": {
      "$type": "fontWeight",
      "$value": "var(--hh-font-weight-bold)",
      "$description": "Archivo 700, a real cut of the variable face."
    },
    "type-strip-header-family": {
      "$type": "fontFamily",
      "$value": "var(--hh-font-sans)",
      "$description": "Round titles are scanned all day: Archivo, never the wide face."
    },
    "type-strip-header-size": {
      "$type": "dimension",
      "$value": "1.125rem",
      "$description": "Round titles sit at or above the Question prompt size (body-lg), so the title leads the strip."
    },
    "type-strip-header-line-height": {
      "$type": "number",
      "$value": 1.3,
      "$description": "Two-line titles stay compact."
    },
    "type-strip-header-weight": {
      "$type": "fontWeight",
      "$value": "var(--hh-font-weight-semibold)",
      "$description": "Archivo 600, a real cut of the variable face."
    },
    "letter-spacing-caps": {
      "$type": "dimension",
      "$value": "0.08em",
      "$description": "Tracking for the short uppercase legends that remain (status words, badges, poll calls)."
    },
    "letter-spacing-tight": {
      "$type": "dimension",
      "$value": "0em",
      "$description": "The wide display face is never tightened."
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "0.0625rem",
      "$description": "Machined key caps and holder tabs: barely broken edges."
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "0.1875rem",
      "$description": "Console modules, inputs, cards."
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "0.375rem",
      "$description": "Dialog and sheet bezels."
    },
    "elevation-raised": {
      "$type": "shadow",
      "$value": "0 0.0625rem 0.1875rem 0 var(--hh-shadow)",
      "$description": "Soft contact depth: modules sit on the desk without a hard offset lip."
    },
    "elevation-overlay": {
      "$type": "shadow",
      "$value": "0 0.875rem 1.75rem -0.5rem var(--hh-shadow)",
      "$description": "Overlays lift off the desk."
    },
    "elevation-live": {
      "$type": "shadow",
      "$value": "0 0 0.5rem 0 var(--hh-live)",
      "$description": "A tight bloom in the live colour, for live state only."
    }
  },
